# Copy to .env and fill in. The same variables go in Netlify → Environment variables.
ADMIN_PASSWORD=
SESSION_SECRET=any-long-random-string
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=service_
EMAILJS_TEMPLATE_ID=template_
REMINDER_TZ=Asia/Kolkata

# Web Push — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google sign-in (Firebase Authentication) — optional. Firebase console > Project settings > Your apps > Web app > apiKey
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=device-streaming-a4f3601d
# FIREBASE_AUTH_DOMAIN=device-streaming-a4f3601d.firebaseapp.com
